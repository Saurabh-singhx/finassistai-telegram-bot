# ---- App ----
ENV=development

# ---- Database (Supabase Postgres, use the pooled/asyncpg-compatible URL) ----
# Example: postgresql+asyncpg://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/finassist

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ---- LLM (Gemini) ----
GOOGLE_API_KEY=your_google_api_key_here
LLM_MODEL=gemini-2.0-flash

# ---- Market Data (Phase 1) ----
FINNHUB_API_KEY=your_finnhub_key
FRED_API_KEY=your_fred_key
SEC_EDGAR_USER_AGENT="YourAppName contact@youremail.com"

# ---- Market Data (Phase 2, optional) ----
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=
POLYGON_API_KEY=

# ---- Google OAuth (Gmail read, Calendar meeting creation, Drive read) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ---- Scheduler defaults ----
DEFAULT_BRIEFING_TIME=08:00
DEFAULT_TIMEZONE=Asia/Kolkata
